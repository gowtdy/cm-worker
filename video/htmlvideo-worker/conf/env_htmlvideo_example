CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-pro
# Only used when HTMLVIDEO_CLAUDE_PROFILE=off (or skill=None). Profile-on
# runs override this per skill via CLAUDE_CODE_EFFORT_LEVEL in the child env.
CLAUDE_CODE_EFFORT_LEVEL=high
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Strip built-in git/PR workflow instructions + git status from the Claude
# Code system prompt. htmlvideo skills never use those; run_claude also
# injects this into the child env by default.
CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000

